<mujoco model="ga_stt_cf2_scene">
  <!-- Wraps the real Bitcraze Crazyflie 2 MJCF from the MuJoCo Menagerie
       (crazyflie_menagerie/cf2.xml, imported unmodified) with a floor and
       obstacle markers for the GA-STT reach-avoid-stay validation run.
       The cf2 body's own thrust/torque actuators are left in place but
       UNUSED (their gear scaling is explicitly noted upstream as an
       untuned placeholder, see crazyflie_menagerie/README.md item 5); the
       controller instead drives the body directly via xfrc_applied, using
       the model's real mass (0.027 kg) and inertia
       (2.3951e-5, 2.3951e-5, 3.2347e-5 kg m^2). -->
  <include file="cf2.xml"/>

  <statistic meansize=".05"/>
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-20" elevation="-20" ellipsoidinertia="true"/>
  </visual>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>
  <worldbody>
    <light pos="0 0 2" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    <!-- Obstacle markers, VISUAL ONLY (no collision: the STT generator
         handles avoidance in the reference, not MuJoCo contact physics) --
         positions updated from Python each step to match the moving obstacle. -->
    <body name="obstacle0" pos="0.6 0.6 0.5" mocap="true">
      <geom type="sphere" size="0.15" rgba="0.9 0.2 0.2 0.35" contype="0" conaffinity="0"/>
    </body>
    <body name="target_marker" pos="1.2 1.2 1.0" mocap="true">
      <geom type="sphere" size="0.04" rgba="0.2 0.9 0.2 0.6" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>
